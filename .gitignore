# Ephemeral decrypt-investigation artifacts (regenerable by re-running the scripts)
# Any *.last.json / *.run.log / *.capture.json under tools/ is a captured
# run artifact, not source — always regenerable.
tools/*.last.json
tools/*.run.log
tools/*.capture.json
tools/capture_*.json
tools/*.patched.wasm
tools/recover_keystream.analysis.json

# Regenerable deobfuscated working copy (canonical copies live in deobfuscated/)
deobfuscated_current/

# Local Claude Code harness state
.claude/

# cached live bundles (fetched on demand; never committed)
data/live/
